<UserControl x:Class="MythKit.Pages.Home.HomeIndex"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MythKit.Pages.Home"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             xmlns:mythware="clr-namespace:MythKit.Mythware"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <ui:ScrollViewerEx>
        <ikw:SimpleStackPanel
			Margin="48, 24"
			Spacing="24">
            <ikw:SimpleStackPanel Spacing="8">
                <TextBlock Text="极域状态" FontWeight="Bold" FontSize="16"/>
                <ItemsControl ItemsSource="{Binding MythwareInstances}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon FontSize="50" Grid.Column="0">
                                    <ui:FontIcon.Style>
                                        <Style TargetType="ui:FontIcon">
                                            <Style.Triggers>
                                                <!-- 当 State == Running -->
                                                <DataTrigger Binding="{Binding State}" 
                                                 Value="{x:Static mythware:MythwareState.Running}">
                                                    <Setter Property="Foreground" Value="Green" />
                                                    <Setter Property="Icon" Value="{x:Static ui:FluentSystemIcons.CheckboxChecked_16_Filled}" />
                                                </DataTrigger>

                                                <!-- 当 State == NotRunning -->
                                                <DataTrigger Binding="{Binding State}" 
                                                 Value="{x:Static mythware:MythwareState.NotRunning}">
                                                    <Setter Property="Foreground" Value="Orange" />
                                                    <Setter Property="Icon" Value="{x:Static ui:FluentSystemIcons.List_16_Filled}" />
                                                </DataTrigger>

                                                <!-- 当 State == Invalid -->
                                                <DataTrigger Binding="{Binding State}" 
                                                 Value="{x:Static mythware:MythwareState.Invalid}">
                                                    <Setter Property="Foreground" Value="Gray" />
                                                    <Setter Property="Icon" Value="{x:Static ui:FluentSystemIcons.Question_16_Filled}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:FontIcon.Style>
                                </ui:FontIcon>
                                <ikw:SimpleStackPanel
						            VerticalAlignment="Center"
						            Spacing="5" Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock FontWeight="Bold" FontSize="24">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <!-- 当 State == Running -->
                                                    <DataTrigger Binding="{Binding State}" 
                                                        Value="{x:Static mythware:MythwareState.Running}">
                                                        <Setter Property="Text" Value="正在运行" />
                                                    </DataTrigger>

                                                    <!-- 当 State == NotRunning -->
                                                    <DataTrigger Binding="{Binding State}" 
                                                        Value="{x:Static mythware:MythwareState.NotRunning}">
                                                        <Setter Property="Text" Value="未在运行" />
                                                    </DataTrigger>

                                                    <!-- 当 State == Invalid -->
                                                    <DataTrigger Binding="{Binding State}" 
                                                        Value="{x:Static mythware:MythwareState.Invalid}">
                                                        <Setter Property="Text" Value="发现极域安装，但未找到学生端" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="路径:"/>
                                        <Run Text="{Binding MythwarePath, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="PID:"/>
                                        <Run Text="{Binding Pid, Mode=OneWay}"/>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <!-- 当 State == Running -->
                                                    <DataTrigger Binding="{Binding State}" 
                                                        Value="{x:Static mythware:MythwareState.Running}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </ikw:SimpleStackPanel>
                                <Button Grid.Column="3" Click="OpenDirectoryButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                            <Setter Property="Content" Value="打开所在文件夹"/>
                                            <Style.Triggers>
                                                <!-- 当 State == Invalid -->
                                                <DataTrigger Binding="{Binding State}" 
                                                    Value="{x:Static mythware:MythwareState.Invalid}">
                                                    <Setter Property="Content" Value="尝试打开所在文件夹"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Grid.Column="4" Click="JiYuOperateButton_Click" Margin="10,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <!-- 当 State == Running -->
                                                <DataTrigger Binding="{Binding State}" 
                                                    Value="{x:Static mythware:MythwareState.Running}">
                                                    <Setter Property="Content" Value="关闭"/>
                                                </DataTrigger>
                                                <!-- 当 State == NotRunning -->
                                                <DataTrigger Binding="{Binding State}" 
                                                    Value="{x:Static mythware:MythwareState.NotRunning}">
                                                    <Setter Property="Content" Value="启动"/>
                                                </DataTrigger>
                                                <!-- 当 State == Invalid -->
                                                <DataTrigger Binding="{Binding State}" 
                                                    Value="{x:Static mythware:MythwareState.Invalid}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ikw:SimpleStackPanel>
            <ikw:SimpleStackPanel Spacing="8" Name="SuggestionsBox">
                <TextBlock FontWeight="Bold" Text="建议的操作" FontSize="16"/>
                <WrapPanel Name="SuggestionsPanel" ItemHeight="Auto" SizeChanged="SuggestionsPanel_SizeChanged" ItemWidth="200"/>
            </ikw:SimpleStackPanel>
        </ikw:SimpleStackPanel>
    </ui:ScrollViewerEx>
</UserControl>
