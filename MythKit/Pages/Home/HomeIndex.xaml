<UserControl x:Class="MythKit.Pages.Home.HomeIndex"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MythKit.Pages.Home"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             xmlns:mythware="clr-namespace:MythKit.Mythware"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <ui:ScrollViewerEx>
        <ikw:SimpleStackPanel
			Margin="48, 24"
			Spacing="24">
            <ikw:SimpleStackPanel Spacing="8">
                <TextBlock Text="极域状态" FontWeight="Bold" FontSize="16"/>
                <ItemsControl ItemsSource="{Binding MythwareInstances}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                <ui:FontIcon FontSize="50">
                                    <ui:FontIcon.Style>
                                        <Style TargetType="ui:FontIcon">
                                            <Style.Triggers>
                                                <!-- 当 State == Running -->
                                                <DataTrigger Binding="{Binding State}" 
                                                 Value="{x:Static mythware:MythwareState.Running}">
                                                    <Setter Property="Foreground" Value="Green" />
                                                    <Setter Property="Icon" Value="{x:Static ui:FluentSystemIcons.CheckboxChecked_16_Filled}" />
                                                </DataTrigger>

                                                <!-- 当 State == NotRunning -->
                                                <DataTrigger Binding="{Binding State}" 
                                                 Value="{x:Static mythware:MythwareState.NotRunning}">
                                                    <Setter Property="Foreground" Value="Orange" />
                                                    <Setter Property="Icon" Value="{x:Static ui:FluentSystemIcons.List_16_Filled}" />
                                                </DataTrigger>

                                                <!-- 当 State == Invalid -->
                                                <DataTrigger Binding="{Binding State}" 
                                                 Value="{x:Static mythware:MythwareState.Invalid}">
                                                    <Setter Property="Foreground" Value="Gray" />
                                                    <Setter Property="Icon" Value="{x:Static ui:FluentSystemIcons.Question_16_Filled}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:FontIcon.Style>
                                </ui:FontIcon>
                                <ikw:SimpleStackPanel
						            VerticalAlignment="Center"
						            Spacing="5">
                                    <TextBlock FontWeight="Bold" FontSize="24">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <!-- 当 State == Running -->
                                                    <DataTrigger Binding="{Binding State}" 
                                                        Value="{x:Static mythware:MythwareState.Running}">
                                                        <Setter Property="Text" Value="正在运行" />
                                                    </DataTrigger>

                                                    <!-- 当 State == NotRunning -->
                                                    <DataTrigger Binding="{Binding State}" 
                                                        Value="{x:Static mythware:MythwareState.NotRunning}">
                                                        <Setter Property="Text" Value="未在运行" />
                                                    </DataTrigger>

                                                    <!-- 当 State == Invalid -->
                                                    <DataTrigger Binding="{Binding State}" 
                                                        Value="{x:Static mythware:MythwareState.Invalid}">
                                                        <Setter Property="Text" Value="发现极域安装，但未找到学生端" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="路径:"/>
                                        <Run Text="{Binding MythwarePath, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="PID:"/>
                                        <Run Text="{Binding Pid, Mode=OneWay}"/>
                                    </TextBlock>
                                </ikw:SimpleStackPanel>
                            </ikw:SimpleStackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
