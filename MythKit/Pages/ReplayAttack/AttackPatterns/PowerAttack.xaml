<UserControl x:Class="MythKit.Pages.ReplayAttack.AttackPatterns.PowerAttack"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="400">
    <ikw:SimpleStackPanel Spacing="16">
		<ui:RadioButtons Header="电源选项">
			<RadioButton Name="RestartRadioButton" Content="重启" IsChecked="True" />
			<RadioButton Name="ShutdownRadioButton" Content="关机" />
		</ui:RadioButtons>
    </ikw:SimpleStackPanel>
</UserControl>
