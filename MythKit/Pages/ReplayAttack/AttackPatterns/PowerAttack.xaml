<UserControl x:Class="MythKit.Pages.ReplayAttack.AttackPatterns.PowerAttack"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="400">
    <ikw:SimpleStackPanel Spacing="16">
		<ui:RadioButtons Header="选项">
			<RadioButton Name="RestartRadioButton" Content="重启" IsChecked="True" />
			<RadioButton Name="ShutdownRadioButton" Content="关机" />
            <RadioButton Name="CloseApplicationRadioButton" Content="关闭应用程序" />
        </ui:RadioButtons>
        <CheckBox Name="ImmediateExecutionCheckBox" Content="立即执行，不发送消息"/>
        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
            <TextBox
			    Name="Message"
			    ui:ControlHelper.Header="消息"
			    ui:ControlHelper.PlaceholderText="（支持字符串格式化）执行操作时的消息" />
            <ui:NumberBox MinWidth="150" ui:ControlHelper.Header="延迟时间（秒）" Name="Countdown" Minimum="0" SpinButtonPlacementMode="Compact"/>
        </ikw:SimpleStackPanel>
    </ikw:SimpleStackPanel>
</UserControl>
