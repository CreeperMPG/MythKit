<ui:ContentDialog x:Class="MythKit.Pages.StudentManager.RecoverySettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MythKit.Pages.StudentManager"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             mc:Ignorable="d" 
             DefaultButton="Close"
             Title="系统功能恢复"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <ikw:SimpleStackPanel Spacing="8" Margin="0, 10, 0, 0" Name="PendingPanel">
            <ui:ProgressRing/>
            <TextBlock Text="正在恢复系统功能，请稍等" HorizontalAlignment="Center"/>
        </ikw:SimpleStackPanel>
        <ui:ScrollViewerEx>
            <ikw:SimpleStackPanel Spacing="8" Name="ResultPanel" Visibility="Collapsed">
                <TextBlock Text="恢复结果" FontWeight="Bold" FontSize="16"/>
                <TextBlock Text="若错误较多可尝试以管理员权限重启后重试" Name="AdminPrompt"/>
                <ItemsControl ItemsSource="{Binding RecoveryResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:InfoBar Margin="0, 0, 0, 8" IsOpen="True" Title="{Binding Item1}" Message="{Binding Item3}" IsClosable="False">
                                <ui:InfoBar.Style>
                                    <Style TargetType="ui:InfoBar">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Item2}" Value="True">
                                                <Setter Property="Severity" Value="Success"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Item2}" Value="False">
                                                <Setter Property="Severity" Value="Warning"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:InfoBar.Style>
                            </ui:InfoBar>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ikw:SimpleStackPanel>
        </ui:ScrollViewerEx>
    </Grid>
</ui:ContentDialog>
