<UserControl x:Class="MythKit.Pages.UDPAttack.AttackFunctions.TeacherAttack.RaiseHandAttack"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MythKit.Pages.UDPAttack.AttackFunctions.TeacherAttack"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ikw:SimpleStackPanel Spacing="16">
        <TextBlock Text="这是针对教师端的攻击类型，请填写教师端 IP。"/>
        <Slider
            Name="RaiseHandInterval"
            Minimum="1"
            ui:ControlHelper.Header="举手间隔（毫秒）"
            Maximum="1000"
            Value="500" />
        <ui:NumberBox Value="1" SpinButtonPlacementMode="Inline" Minimum="1" Maximum="32" MinWidth="100" ui:ControlHelper.Header="极域频道" Name="TDChannelID"/>
    </ikw:SimpleStackPanel>
</UserControl>
